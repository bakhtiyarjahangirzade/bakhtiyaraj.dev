{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "SiteFilter",
  "description": "__MSG_extDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "author": "Bakhtiyar Jahangirzade",
  "homepage_url": "https://bakhtiyaraj.dev/apps/sitefilter/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SiteFilter",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/lib.js", "src/presets.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmdToggle__"
    },
    "start-picker": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "__MSG_cmdPick__"
    }
  }
}
