{
  "name": "bakhy",
  "version": "0.1.0",
  "private": true,
  "description": "BAKHY: a free and open-source personal developer hub",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/vendor.mjs && node scripts/build.mjs && vite build --config storefront/vite.config.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
