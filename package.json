    "build:function": "node scripts/build-function.mjs",
    "dev:play": "node scripts/dev-play.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.3.1",
    "@supabase/supabase-js": "2.45.4",
    "7zip-bin": "5.2.0",
    "chess.js": "1.0.0-beta.8",
    "esbuild": "0.25.10",
    "fflate": "^0.8.2",
    "resedit": "2.0.3",
    "unpdf": "^0.11.0",
    "vite": "7.1.12"
  }
}
